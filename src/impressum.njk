<style>
  .impressum-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 8rem 3rem 6rem;
  }
  .impressum-wrap h1 {
    font-family: var(--ff-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 400;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }
  .impressum-wrap .divider {
    width: 3rem;
    height: 1px;
    background: var(--gold);
    margin: 1.5rem 0 3rem;
  }
  .impressum-wrap h2 {
    font-family: var(--ff-body);
    font-size: 0.7rem;
    font-weight: 500;
