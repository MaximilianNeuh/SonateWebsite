    text-transform: uppercase;
    color: var(--gold);
    margin: 2.5rem 0 0.75rem;
  }
  .impressum-wrap p {
    font-size: 0.95rem;
    font-weight: 300;
    color: var(--muted);
    line-height: 1.8;
  }
  .impressum-wrap a {
    color: var(--gold);
    text-decoration: none;
  }
  .impressum-wrap a:hover {
    color: var(--gold-lt);
  }
  .placeholder {
    background: var(--parchment);
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    color: var(--muted);
    font-style: italic;
  }
